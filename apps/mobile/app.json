{
  "expo": {
    "name": "Spotibai",
    "slug": "spotibai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/spotibai-icon.png",
    "scheme": "spotibai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jcmejia.spotibai",
      "adaptiveIcon": {
        "backgroundColor": "#120d1a",
        "foregroundImage": "./assets/images/spotibai-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/spotibai-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110c17",
          "image": "./assets/images/spotibai-icon.png",
          "imageWidth": 110
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
